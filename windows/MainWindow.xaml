<Window
    x:Class="ZenStream.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ZenStream Studio"
    Closed="Window_Closed">
    <Grid
        Padding="24"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="16"
        Loaded="Window_Loaded">
        <TextBlock
            Text="ZenStream Studio"
            FontSize="28"
            FontWeight="SemiBold" />

        <Viewbox Grid.Row="1" Stretch="Uniform">
            <Border
                x:Name="CameraPreviewCanvas"
                Width="1600"
                Height="900"
                Background="Black"
                CornerRadius="8">
                <Grid>
                    <MediaPlayerElement
                        x:Name="CameraPreview"
                        AutoPlay="True"
                        Stretch="Uniform" />
                    <Border
                        Margin="32"
                        Padding="20,12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="#CC0F172A"
                        CornerRadius="8">
                        <TextBlock
                            x:Name="CompositionLabel"
                            Text="ZenStream Studio - Horizontal 16:9"
                            FontSize="30"
                            FontWeight="SemiBold"
                            Foreground="White" />
                    </Border>
                </Grid>
            </Border>
        </Viewbox>

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="Microphone level" />
            <ProgressBar
                x:Name="MicrophoneLevel"
                Minimum="0"
                Maximum="1"
                Value="0" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="HorizontalButton"
                    Content="Horizontal 16:9"
                    Click="HorizontalButton_Click" />
                <Button
                    x:Name="VerticalButton"
                    Content="Vertical 9:16"
                    Click="VerticalButton_Click" />
            </StackPanel>
            <TextBox
                x:Name="StreamUrlTextBox"
                Header="RTMP destination"
                PlaceholderText="rtmp://host/app/stream" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="RecordButton"
                    Content="Record"
                    IsEnabled="False"
                    Click="RecordButton_Click" />
                <Button
                    x:Name="StopButton"
                    Content="Stop"
                    IsEnabled="False"
                    Click="StopButton_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="GoLiveButton"
                    Content="Go Live"
                    Click="GoLiveButton_Click" />
                <Button
                    x:Name="StopStreamButton"
                    Content="Stop stream"
                    IsEnabled="False"
                    Click="StopStreamButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
