<Window
    x:Class="ZenStream.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ZenStream Studio"
    Closed="Window_Closed">
    <Grid
        Padding="24"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="16"
        Loaded="Window_Loaded">
        <TextBlock
            Text="ZenStream Studio"
            FontSize="28"
            FontWeight="SemiBold" />

        <Border
            Grid.Row="1"
            Background="Black"
            CornerRadius="8">
            <MediaPlayerElement
                x:Name="CameraPreview"
                AutoPlay="True"
                Stretch="Uniform" />
        </Border>

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="Microphone level" />
            <ProgressBar
                x:Name="MicrophoneLevel"
                Minimum="0"
                Maximum="1"
                Value="0" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="RecordButton"
                    Content="Record"
                    IsEnabled="False"
                    Click="RecordButton_Click" />
                <Button
                    x:Name="StopButton"
                    Content="Stop"
                    IsEnabled="False"
                    Click="StopButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
